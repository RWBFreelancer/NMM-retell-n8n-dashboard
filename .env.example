# Ninja Ops Dashboard - environment template.
# Copy to .env.local and fill in. NEVER commit a real value.
# Ask Rey for the values. Never print or log them.

# --- Retell (read-only use) ---
RETELL_API_KEY=
RETELL_BASE_URL=https://api.retellai.com
AGENT_A_ID=
AGENT_A_PHONE=
AGENT_B_ID=
AGENT_B_PHONE=

# --- n8n (read-only use) ---
N8N_API_KEY=
N8N_BASE_URL=
N8N_WORKFLOW_ID=

# --- Login ---
# openssl rand -base64 32
AUTH_SECRET=
DASHBOARD_USERNAME=
# The password, hashed. Never the plain password.
#   npm run hash-password              invents a strong password and prints it
#   npm run hash-password -- --write   the same, and fills this line in for you
# The value looks like s1.32768.8.1.<hex>.<hex>. Letters a-f and s, digits and
# dots only. No $, so nothing here can eat part of it. Paste the value alone:
# no name in front, no quote marks.
DASHBOARD_PASSWORD_HASH=
