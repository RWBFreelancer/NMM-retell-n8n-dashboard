# Ninja Ops Dashboard - environment template.
# Copy to .env.local and fill in. NEVER commit a real value.
# Ask Rey for the values. Never print or log them.

# --- Retell (read-only use) ---
RETELL_API_KEY=
RETELL_BASE_URL=https://api.retellai.com
AGENT_A_ID=
AGENT_A_PHONE=
AGENT_B_ID=
AGENT_B_PHONE=

# --- n8n (read-only use) ---
N8N_API_KEY=
N8N_BASE_URL=
N8N_WORKFLOW_ID=

# --- Login ---
# openssl rand -base64 32
AUTH_SECRET=
DASHBOARD_USERNAME=
# The password, hashed. Never the plain password.
#   npm run hash-password -- "your password here"
# Use the BASE64 line it prints. A raw bcrypt hash starts with $2b$12$ and
# Next.js reads those $ signs as variables, so part of the hash disappears
# and every login fails. Base64 has no $, so it always survives.
DASHBOARD_PASSWORD_HASH=
